# V5-INSIGNIA .editorconfig
# Enforces consistent formatting across all .py files to prevent CRLF/LF mix
# that was found in risk_guardian.py and backtester.py.
# See https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
max_line_length = 120

[*.json]
indent_size = 2

[*.yml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
