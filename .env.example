# Trading Bot V4 - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# MT5 Credentials (if using remote MT5)
# =============================================================================
MT5_SERVER=your-broker-server.com
MT5_LOGIN=12345678
MT5_PASSWORD=your_secure_password

# =============================================================================
# API Keys (optional - for enhanced news data)
# =============================================================================
# tradingeconomics.com API key (free tier available)
TRADINGECONOMICS_API_KEY=your_api_key

# investing.com API key (premium)
INVESTING_API_KEY=your_api_key

# =============================================================================
# VPS / Production Settings
# =============================================================================
# Set to 'true' for production VPS deployment
PRODUCTION_MODE=false

# Health check port (default: 8080)
HEALTH_PORT=8080

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_NEWS_FILTER=true
ENABLE_TRAILING_STOP=true
ENABLE_DASHBOARD=true

# =============================================================================
# Backup & Recovery
# =============================================================================
# Enable automatic state backups (true/false)
ENABLE_STATE_BACKUP=true
# Backup interval in seconds (default: 300 = 5 minutes)
STATE_BACKUP_INTERVAL=300
